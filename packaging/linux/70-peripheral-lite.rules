# peripheral-lite: let the logged-in user talk to Logitech and Corsair HID devices (hidraw), without root.
# Install:
#   sudo cp 70-peripheral-lite.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# then unplug and replug the receiver / headset. Solaar ships a similar rule; either is enough.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", TAG+="uaccess"
